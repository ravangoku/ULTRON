ULTRON_ENVIRONMENT=development
ULTRON_CORS_ORIGINS=http://localhost:5173
ULTRON_LLM_PROVIDER=mock
ULTRON_LLM_MODEL=gpt-4o-mini
# ULTRON_LLM_API_KEY=
# ULTRON_LLM_BASE_URL=https://api.openai.com/v1
ULTRON_STT_PROVIDER=disabled
ULTRON_TTS_PROVIDER=disabled
ULTRON_EMBEDDING_PROVIDER=local
ULTRON_VECTOR_DB=pgvector
ULTRON_DATABASE_URL=postgresql+psycopg://ultron:ultron@postgres:5432/ultron
ULTRON_REDIS_URL=redis://redis:6379/0
ULTRON_WEB_SEARCH_PROVIDER=disabled
ULTRON_EMERGENCY_STOP=false
POSTGRES_DB=ultron
POSTGRES_USER=ultron
POSTGRES_PASSWORD=change-me-in-production
